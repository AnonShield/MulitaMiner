# Environment variables for MulitaMiner.
#
# Copy this file to `.env` (which is gitignored) and fill in your API keys.
# Each variable is referenced by an LLM config in
# src/mulitaminer/configs/llms/*.json as `${VAR_NAME}` and substituted at load
# time. Leave blank / omit the ones you don't use (local models need no key).

# --- Cloud LLM API keys ---
API_KEY_DEEPSEEK=""
API_KEY_GPT4=""
API_KEY_GPT5=""
API_KEY_LLAMA3=""
API_KEY_LLAMA4=""
API_KEY_QWEN3=""
