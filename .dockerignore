# Keep the build context small and never ship secrets or generated data.

# VCS, virtualenvs, caches
.git/
.venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets — must never enter the build context
.env
.env.*
!.env.example

# Generated output / heavy / irrelevant to the image
outputs/
# Prioritization feeds: regenerable cache with daily churn — never bake into the
# image (mount resources/feeds/ as a volume and sync at runtime instead).
resources/feeds/
archive/
memory/
.claude/
docs/
tests/
