function cssEsc(s){ return String(s).replace(/[^a-zA-Z0-9_-]/g, '_'); }

/* ── Drill-down: similarity distribution stacked bars (BERT + ROUGE) ──
   One stacked bar per model for the selected baseline. The dropdown
   above the charts swaps both BERT and ROUGE in sync. */
// SIMILARITY_COLORS is injected from themes.py at the top of this script
// (search for `const SIMILARITY_COLORS`). Single source of truth lives in
// metrics/plot/themes.py — edit there to change the HTML similarity palette.

function similarityChart(canvasId, title){
  return new Chart(document.getElementById(canvasId), {
    type:'bar',
    data:{ labels: [], datasets: [] },
    options:{
      responsive:true, maintainAspectRatio:false,
      scales:{
        x:{ stacked:true, grid:{display:false}, ticks:{autoSkip:false, font:{size:12}} },
        y:{ stacked:true, min:0, max:100, grid, ticks:{callback:v=>v+'%'} },
      },
      layout:{ padding:{bottom:8} },
      plugins:{
        title:{display:true, text:title, color: THEME.text, font:{size:13, weight:'600'}},
        legend:{position:'bottom', labels:{boxWidth:12, padding:8, font:{size:11}}},
        tooltip:{ callbacks:{ label: ctx => `${ctx.dataset.label}: ${ctx.parsed.y.toFixed(1)}%` } },
      },
    }
  });
}

function updateSimilarityChart(chart, perBaseline, models, baseline, categories){
  const dist = perBaseline[baseline] || {};
  chart.data.labels = models;
  chart.data.datasets = categories.map((cat, i) => ({
    label: cat,
    data: models.map(m => (dist[m] ?? [0,0,0,0,0])[i]),
    backgroundColor: SIMILARITY_COLORS[cat] + ALPHA,
    borderColor: SIMILARITY_COLORS[cat],
    borderWidth: 0,
  }));
  chart.update();
}

(function(){
  const d = CHART_DATA.drill_similarity;
  const cBert  = document.getElementById('ch-drill_similarity_bert');
  const cRouge = document.getElementById('ch-drill_similarity_rouge');
  if(d.empty){
    cBert.parentElement.innerHTML  = `<div class="empty">No bert/rouge categorization yet</div>`;
    cRouge.parentElement.innerHTML = `<div class="empty">No bert/rouge categorization yet</div>`;
    document.querySelector('.bl-select-row').style.display = 'none';
    return;
  }
  const sel = document.getElementById('drill_similarity_baseline');
  sel.innerHTML = d.baselines.map(b => `<option value="${escapeHtml(b)}">${escapeHtml(b)}</option>`).join('');
  const bertCh  = similarityChart('ch-drill_similarity_bert',  'BERTScore');
  const rougeCh = similarityChart('ch-drill_similarity_rouge', 'ROUGE-L');
  window._charts.drill_similarity_bert  = bertCh;
  window._charts.drill_similarity_rouge = rougeCh;
  function refresh(){
    const b = sel.value;
    updateSimilarityChart(bertCh,  d.bert,  d.models, b, d.categories);
    updateSimilarityChart(rougeCh, d.rouge, d.models, b, d.categories);
  }
  sel.addEventListener('change', refresh);
  refresh();
})();

