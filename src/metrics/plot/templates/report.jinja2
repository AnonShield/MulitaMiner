  sel.innerHTML = d.baselines.map(b => `<option value="${escapeHtml(b)}">${escapeHtml(b)}</option>`).join('');
  function refresh(){
    const rows = d.rows[sel.value] || [];
    if(!rows.length){
      wrap.innerHTML = `<div class="empty">Nothing missed for this baseline.</div>`;
      return;
    }
    let html = `<table class="lb">
      <thead><tr>
        <th class="lb-rank">#</th>
        <th class="lb-model">Vulnerability name</th>
        <th>Misses</th>
        <th>Miss rate</th>
        <th>Models</th>
      </tr></thead><tbody>`;
    rows.forEach((r, i) => {
      const chips = r.models.map(m => `<span class="mm">${escapeHtml(m)}</span>`).join('');
      html += `<tr>
        <td class="lb-rank">${i+1}</td>
        <td class="lb-model" style="font-family:var(--font-mono);font-size:12px;">${escapeHtml(r.name)}</td>
        <td class="lb-num">${r.count}</td>
        <td class="lb-num">${r.pct.toFixed(1)}%</td>
        <td class="lb-num"><span class="missed-models">${chips}</span><span style="color:var(--text-muted);margin-left:6px;">(${r.n_models})</span></td>
      </tr>`;
    });
    html += `</tbody></table>`;
    wrap.innerHTML = html;
  }
  sel.addEventListener('change', refresh);
  refresh();
})();

/* ── Drill-down: per-field text-scorer heatmaps (BERT, ROUGE, Token-F1) ──
   Baseline selector swaps the 3 heatmaps in sync. The "All baselines"
   option (key __all__) is the legacy global mean. */
(function(){
  const d = CHART_DATA.drill_text;
  const grid = document.getElementById('drill_text_grid');
  const sel  = document.getElementById('drill_text_baseline');
  if(!grid || !sel) return;
  if(d.empty){
    grid.innerHTML = `<div class="empty">No bert/rouge/token_f1 metrics yet</div>`;
    document.querySelector('.card .bl-select-row + #drill_text_grid')?.previousElementSibling?.remove?.();
    return;
  }
  const LABELS = { bert: 'BERTScore F1', rouge: 'ROUGE-L', token_f1: 'Token-F1' };
  const baselineLabel = b => b === '__all__' ? 'All baselines (mean)' : b;

  sel.innerHTML = d.baselines.map(b =>
    `<option value="${escapeHtml(b)}">${escapeHtml(baselineLabel(b))}</option>`
  ).join('');

  // Stack vertically so each heatmap gets full card width.
  grid.style.gridTemplateColumns = '1fr';
  grid.innerHTML = d.available.map(s => `
    <div class="hm-wrap">
      <div class="hm-subhead">${LABELS[s] || s}</div>
      <div class="hm" id="hm-drill_text_${s}"></div>
    </div>`).join('');

  function refresh(){
    const mats = d.matrices[sel.value] || {};
    d.available.forEach(s => {
      renderHeatmap(`hm-drill_text_${s}`, {
        rowLabels: d.models, colLabels: d.fields, matrix: mats[s],
        fmt: v => v.toFixed(3), vmin: 0, vmax: 1,
        legendLabel: LABELS[s] || s, legendMin: '0', legendMax: '1',
      });
    });
  }
  sel.addEventListener('change', refresh);
  refresh();
})();
