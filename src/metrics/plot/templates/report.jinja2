/* ── Heatmap renderers (CSS grid) ── */
function rampColor(v){
  // v in [0,1], maps via RAMP stops to a color string.
  if(v == null || isNaN(v)) return null;
  v = Math.max(0, Math.min(1, v));
  for(let i=1; i<RAMP.length; i++){
    const [s0,c0] = RAMP[i-1], [s1,c1] = RAMP[i];
    if(v <= s1){
      const t = (v - s0) / (s1 - s0);
      return mix(c0, c1, t);
    }
  }
  return RAMP[RAMP.length-1][1];
}
function mix(a, b, t){
  const pa = parseInt(a.slice(1),16), pb = parseInt(b.slice(1),16);
  const r = Math.round(((pa>>16)&255)*(1-t) + ((pb>>16)&255)*t);
  const g = Math.round(((pa>>8)&255)*(1-t)  + ((pb>>8)&255)*t);
  const bl= Math.round((pa&255)*(1-t)       + (pb&255)*t);
  return `rgb(${r},${g},${bl})`;
}
function textOn(bgColor){
  // Pick dark/light text based on bg luminance — uses THEME so contrast
  // tokens stay aligned with the rest of the page.
  const m = bgColor.match(/\d+/g); if(!m) return THEME.text;
  const [r,g,b] = m.map(Number);
  const lum = (0.299*r + 0.587*g + 0.114*b) / 255;
  return lum > 0.6 ? THEME.surface_2 : THEME.text;
}

function renderHeatmap(containerId, opts){
  // opts: {rowLabels, colLabels, matrix, fmt, vmin=0, vmax=1, invertColor=false, emptyMsg, legendLabel}
  const c = document.getElementById(containerId);
  if(!c) return;
  if(!opts.rowLabels.length || !opts.colLabels.length){
    c.innerHTML = `<div class="empty">${opts.emptyMsg || 'No data yet'}</div>`;
    return;
  }
  const ncols = opts.colLabels.length + 1;
  // Auto row-label column so long model names aren't truncated.
  // Cell columns use 0 min so they can shrink when the host CSS overrides
  // the default min-width (e.g. drill-down heatmaps fit the card width).
  const tpl = `minmax(100px, max-content) repeat(${opts.colLabels.length}, minmax(0, 1fr))`;
  let html = `<div class="hm-table" style="grid-template-columns:${tpl};">`;
  html += `<div class="hm-cell hd"></div>`;
  opts.colLabels.forEach(l => html += `<div class="hm-cell hd">${escapeHtml(l)}</div>`);
  opts.matrix.forEach((row, i) => {
    html += `<div class="hm-cell row-h">${escapeHtml(opts.rowLabels[i])}</div>`;
    row.forEach(v => {
      if(v == null){
        html += `<div class="hm-cell empty-cell">—</div>`;
      } else {
        const norm = (v - opts.vmin) / (opts.vmax - opts.vmin);
        const t = opts.invertColor ? 1 - norm : norm;
        const bg = rampColor(t);
        const fg = textOn(bg);
        html += `<div class="hm-cell" style="background:${bg};color:${fg};">${opts.fmt(v)}</div>`;
      }
    });
  });
  html += `</div>`;
  if(opts.legendLabel){
    // Build the gradient straight from RAMP so the strip is always in sync
    // with the actual cell colormap — no risk of stale CSS.
    const stops = RAMP.map(([s, col]) => `${col} ${(s*100).toFixed(0)}%`).join(',');
    const gradient = `linear-gradient(to right, ${stops})`;
    html += `<div class="hm-legend"><span>${opts.legendMin || opts.vmin}</span><div class="hm-ramp" style="background:${gradient};"></div><span>${opts.legendMax || opts.vmax} — ${opts.legendLabel}</span></div>`;
  }
  c.innerHTML = html;
}
function escapeHtml(s){ return String(s).replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch])); }

